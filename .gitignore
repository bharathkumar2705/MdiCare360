# ─── Environment & Secrets (NEVER COMMIT) ────────────────
.env
.env*.local
.env.development
.env.production
server/.env
client/.env

# ─── Dependencies ─────────────────────────────────────────
node_modules/
client/node_modules/
server/node_modules/

# ─── Build Artifacts & Distribution ───────────────────────
dist/
client/dist/
build/
.cache/

# ─── Logs & Debug ─────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log

# ─── Server Uploads (Keep folder, ignore uploaded files) ──
server/uploads/*
!server/uploads/.gitkeep

# ─── IDE & OS Metadata ────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
